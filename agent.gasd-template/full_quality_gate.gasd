VERSION 1.2
/*
   Template for agent.md/full_quality_gate.md.

   Replace placeholders:
   - <SEMANTIC_AST_COMMAND>
   - <BUILD_PLAN_PATH>
   - <QUALITY_GATE_PHASE>
   - <STORY_ID_RANGE>
   - <TEST_COMMAND>
   - <IMPLEMENTATION_SCOPE>
   - <PAUSE_CONDITION>
*/
CONTEXT: "Agent template: full quality gate"
TARGET: "GASD Agent / Testing Agent Template"
TRACE: "SOURCE-FULL-QUALITY-GATE-SCRIPT-PATH"
NAMESPACE: "agent.template.full_quality_gate"

CONSTRAINT: "Agent MUST use <SEMANTIC_AST_COMMAND> to generate semantic AST for GASD as input to POX when required."
CONSTRAINT: "Agent MUST become a GASD testing expert before quality-gate execution."
CONSTRAINT: "Agent MUST do only what is requested and nothing more."
CONSTRAINT: "Agent MUST execute the intended quality-gate scope and then wait for the next instruction."
CONSTRAINT: "Implementation in <IMPLEMENTATION_SCOPE> MUST be fixed until all required tests pass when quality-gate execution is requested."

FLOW execute_full_quality_gate_by_story_template():
    1. ACHIEVE "Read <BUILD_PLAN_PATH> <QUALITY_GATE_PHASE>":
        POSTCONDITION: result.quality_gate_phase_loaded == true
    2. ACHIEVE "Execute <QUALITY_GATE_PHASE> one user story at a time from <STORY_ID_RANGE>":
        POSTCONDITION: result.story_scoped_quality_gate_complete == true
    3. ACHIEVE "Run <TEST_COMMAND> for the current quality-gate scope":
        POSTCONDITION: result.test_command_completed == true
    4. ACHIEVE "Fix <IMPLEMENTATION_SCOPE> until all tests for the current user story pass":
        POSTCONDITION: result.current_story_tests_passing == true
    5. ENSURE "Quality-gate outcome is complete for each requested user story"
        OTHERWISE THROW QualityGateError

FLOW execute_full_quality_gate_all_areas_template():
    1. ACHIEVE "Read <BUILD_PLAN_PATH> <QUALITY_GATE_PHASE>":
        POSTCONDITION: result.quality_gate_phase_loaded == true
    2. ACHIEVE "Execute <QUALITY_GATE_PHASE> for all areas and run <TEST_COMMAND> to validate":
        POSTCONDITION: result.all_area_quality_gate_executed == true
    3. ACHIEVE "Fix <IMPLEMENTATION_SCOPE> until all required tests pass":
        POSTCONDITION: result.all_required_tests_passing == true
    4. ENSURE "All full-quality-gate tests pass"
        OTHERWISE THROW QualityGateError
    5. ACHIEVE "Pause at <PAUSE_CONDITION> and wait for the next human instruction":
        POSTCONDITION: result.paused_for_human_instruction == true
