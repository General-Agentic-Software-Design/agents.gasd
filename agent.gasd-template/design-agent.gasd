VERSION 1.2
/*
   Template for agent.md/design-agent.md.

   Replace placeholders:
   - <GASD_METAMODEL_PATH>
   - <BUILD_PLAN_PATH>
   - <DESIGN_PHASE>
   - <STORY_ID_RANGE>
   - <REQUIREMENTS_USER_STORIES_PATH>
   - <DESIGN_OUTPUT_GLOB>
   - <VALIDATION_COMMAND>
   - <PAUSE_CONDITION>
*/
CONTEXT: "Agent template: GASD design generation and hardening"
TARGET: "GASD Agent / Design Agent Template"
TRACE: "SOURCE-DESIGN-AGENT-SCRIPT-PATH"
NAMESPACE: "agent.template.design"

CONSTRAINT: "Agent MUST become a GASD design expert by reading <GASD_METAMODEL_PATH>."
CONSTRAINT: "Agent MUST do only what is requested and nothing more."
CONSTRAINT: "Agent MUST execute only the intended design scope and then wait for the next instruction."
CONSTRAINT: "Generated <DESIGN_OUTPUT_GLOB> artifacts MUST capture all requirements thoroughly."
CONSTRAINT: "Generated <DESIGN_OUTPUT_GLOB> artifacts MUST NOT contain weak null-only ACHIEVE postconditions."
CONSTRAINT: "Every ACHIEVE POSTCONDITION in generated <DESIGN_OUTPUT_GLOB> artifacts MUST assert a concrete, measurable design outcome."
CONSTRAINT: "Generated GASD artifacts MUST be checked with <VALIDATION_COMMAND>."

FLOW generate_design_template():
    1. ACHIEVE "Read and master <GASD_METAMODEL_PATH>":
        POSTCONDITION: result.gasd_metamodel_mastered == true
    2. ACHIEVE "Read <BUILD_PLAN_PATH> <DESIGN_PHASE>":
        POSTCONDITION: result.design_phase_loaded == true
    3. ACHIEVE "Execute <DESIGN_PHASE> for one user story at a time from <STORY_ID_RANGE>":
        POSTCONDITION: result.story_scoped_design_generation_complete == true
    4. ENSURE "Generated <DESIGN_OUTPUT_GLOB> artifacts are thorough and capture all requirements"
        OTHERWISE THROW DesignCoverageError
    5. ACHIEVE "Audit generated <DESIGN_OUTPUT_GLOB> ACHIEVE postconditions for concrete semantic outcomes":
        POSTCONDITION: result.weak_postcondition_count == 0
    6. ENSURE "No generated <DESIGN_OUTPUT_GLOB> artifact contains a weak null-only ACHIEVE postcondition"
        OTHERWISE THROW WeakPostconditionError
    7. ACHIEVE "Validate generated GASD artifacts with <VALIDATION_COMMAND>":
        POSTCONDITION: result.validation_passed == true
    8. ACHIEVE "Pause at <PAUSE_CONDITION> and wait for the next human instruction":
        POSTCONDITION: result.paused_for_human_instruction == true

FLOW harden_design_template():
    1. ACHIEVE "Audit <DESIGN_OUTPUT_GLOB> against <REQUIREMENTS_USER_STORIES_PATH>":
        POSTCONDITION: result.requirements_trace_audit_complete == true
    2. ENSURE "<DESIGN_OUTPUT_GLOB> captures every required #US, #AC, #AT, and #RT thoroughly"
        OTHERWISE THROW DesignTraceabilityError
    3. ENSURE "<DESIGN_OUTPUT_GLOB> is hardened for deterministic downstream code generation"
        OTHERWISE THROW DesignHardeningError
    4. ACHIEVE "Audit every ACHIEVE POSTCONDITION in <DESIGN_OUTPUT_GLOB> for concrete, measurable design outcomes":
        POSTCONDITION: result.weak_postcondition_count == 0
    5. ENSURE "No hardened <DESIGN_OUTPUT_GLOB> artifact contains a weak null-only ACHIEVE postcondition"
        OTHERWISE THROW WeakPostconditionError
    6. ACHIEVE "Validate generated GASD artifacts with <VALIDATION_COMMAND>":
        POSTCONDITION: result.validation_passed == true
    7. ACHIEVE "Pause at <PAUSE_CONDITION> and wait for the next human instruction":
        POSTCONDITION: result.paused_for_human_instruction == true
